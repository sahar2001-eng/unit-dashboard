#!/bin/bash
# UNIT Dashboard launcher.
#
# Starts the Flask server if it is not already up, waits for it to answer,
# then opens the page. Clicking it again when it is already running just
# opens the page -- it never starts a second server.
#
# The project path is resolved from the bundle's own location, so the app
# keeps working if the folder is moved (as long as the app stays inside it).

set -u
PORT="${UNIT_PORT:-5050}"
URL="http://127.0.0.1:$PORT/"

# .../unit-rotation-dashboard/UNIT Dashboard.app/Contents/MacOS/unit-dashboard
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJ="$(cd "$HERE/../../.." && pwd)"

# If the app was copied OUT of the project (dragged to /Applications, say),
# the path above points somewhere with no app.py. Fall back to where the
# project was when this app was built. Dragging to the DOCK is fine either
# way -- that makes an alias and does not move the bundle.
FALLBACK="/Users/saharfishler/Documents/Documents - sahar’s MacBook Pro/robo_ae3/unit-rotation-dashboard"
[ -f "$PROJ/app.py" ] || PROJ="$FALLBACK"
PY="$PROJ/.venv/bin/python"
LOG="$PROJ/server.log"

fail() {   # a GUI app has no terminal to print to
    osascript -e "display dialog \"$1\" with title \"UNIT Dashboard\" buttons {\"OK\"} default button 1 with icon caution" >/dev/null 2>&1
    exit 1
}

[ -x "$PY" ] || fail "Python environment missing.\n\nExpected:\n$PY\n\nOpen Terminal in the project folder and run:\n  python3 -m venv --system-site-packages .venv\n  .venv/bin/pip install -r requirements.txt"
[ -f "$PROJ/app.py" ] || fail "app.py not found in\n$PROJ\n\nKeep this app inside the project folder."

# Already up? Then just show it.
if curl -fsS -m 2 -o /dev/null "$URL"api/status 2>/dev/null; then
    open "$URL"
    exit 0
fi

cd "$PROJ" || fail "Cannot enter $PROJ"
nohup "$PY" app.py >> "$LOG" 2>&1 &

for _ in $(seq 1 40); do          # up to ~20 s; a cold start is ~2 s
    if curl -fsS -m 2 -o /dev/null "$URL"api/status 2>/dev/null; then
        open "$URL"
        exit 0
    fi
    sleep 0.5
done

fail "The dashboard did not start within 20 seconds.\n\nLast lines of server.log:\n\n$(tail -6 "$LOG" 2>/dev/null | sed 's/"/\\"/g')"
